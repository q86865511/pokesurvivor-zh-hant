{
  "manifest_version": 3,
  "name": "PokeSurvivor 繁體中文（預設語言）",
  "version": "2.0.0",
  "description": "讓 PokéSurvivor 預設使用遊戲內建的繁體中文；之後在遊戲設定改語言仍以玩家選擇為準。",
  "content_scripts": [
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://www.pokesurvivor.com/*"
      ],
      "js": ["set-lang.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
